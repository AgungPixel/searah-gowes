{
  "name": "gowes-bareng",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/local-setup.mjs && vite dev --host 127.0.0.1",
    "build": "vite build",
    "preview": "wrangler pages dev .svelte-kit/cloudflare",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "prepare": "svelte-kit sync",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/remote-migrate.mjs",
    "db:seed": "node --experimental-strip-types scripts/seed.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:integration": "node scripts/integration-test.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:integration"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@sveltejs/adapter-cloudflare": "^5.1.0",
    "@sveltejs/kit": "^2.37.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22.18.6",
    "miniflare": "5.20261012.0-beta",
    "esbuild": "^0.25.10",
    "svelte": "^5.39.0",
    "svelte-check": "^4.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "wrangler": "^4.45.0"
  }
}
